#!/bin/zsh
usage() {
	cat <<'EOF'
Usage: poweroff-after [-s SECONDS] COMMAND_PATTERN

Wait until processes matching COMMAND_PATTERN finish, then power off the system.

Options:
  -s SECONDS  Poll interval in seconds. Default: 30.
  -h, --help  Show this help.
EOF
}

convertsecs() {
 ((h=${1}/3600))
 ((m=(${1}%3600)/60))
 ((s=${1}%60))
 printf "%02d:%02d:%02d\n" $h $m $s
}

SELF=$$
SCRIPT_NAME="${0:t}"
SLEEP_SECONDS=30

matching_pids() {
	local pattern="$1"
	local pid
	local comm
	local args

	for pid in ${(f)"$(pgrep -f -- "$pattern")"}; do
		[[ -z "$pid" || "$pid" = "$SELF" ]] && continue
		comm=$(ps -p "$pid" -o comm= 2>/dev/null) || continue
		args=$(ps -p "$pid" -o args= 2>/dev/null) || continue
		[[ "$comm" = "pgrep" ]] && continue
		[[ "$args" == *"$SCRIPT_NAME"* ]] && continue
		print "$pid $args"
	done
}

if [[ "${1:-}" = "--help" ]]; then
	usage
	exit 0
fi

while getopts "hs:" opt; do
	case "$opt" in
		h)
			usage
			exit 0
			;;
		s)
			SLEEP_SECONDS="$OPTARG"
			;;
		*)
			usage >&2
			exit 64
			;;
	esac
done

shift $((OPTIND - 1))

if [[ -z "$1" ]]; then
	echo "poweroff-after: missing COMMAND_PATTERN" >&2
	usage >&2
	exit 64
fi

if ! [[ "$SLEEP_SECONDS" =~ '^[0-9]+$' ]] || (( SLEEP_SECONDS <= 0 )); then
	echo "poweroff-after: invalid -s value: $SLEEP_SECONDS" >&2
	exit 64
fi

if [[ -z "$(matching_pids "$1")" ]]; then
	echo "No matching process is running."
	exit 2
fi

inizio=$(date +%s)
while true; do
	pids="$(matching_pids "$1")"
	[[ -z "$pids" ]] && break
	ora=$(date +%s)
	secondi=$((ora-inizio))
	print -n "\rWaiting for $1 to finish: $(convertsecs $secondi)"
	sleep "$SLEEP_SECONDS"
done

print "\nFinished, powering off..."
poweroff
