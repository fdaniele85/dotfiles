#!/usr/bin/env zsh

usage() {
	cat <<'EOF'
Usage: tag-books [-r|--rename] [-d|--date DATE] DIRECTORY...

Tag MP3 audiobook files using metadata inferred from each directory name.

Options:
  -r, --rename     Rename MP3 files before tagging.
  -d, --date DATE  Base date passed to GNU date. Default: today.
  -h, --help       Show this help.

Directory names are expected to look like:
  Author - Title
  001 - Author - Title
EOF
}

rename_files=false
base_date="today"
typeset -a dirs

while [[ $# -gt 0 ]]; do
	case "$1" in
		-r|--rename)
			rename_files=true
			shift
			;;
		-d|--date)
			if [[ -z "${2:-}" || "${2:0:1}" == "-" ]]; then
				print -u2 -- "tag-books: --date requires a value"
				exit 64
			fi
			base_date="$2"
			shift 2
			;;
		-h|--help)
			usage
			exit 0
			;;
		--)
			shift
			dirs+=("$@")
			break
			;;
		-*)
			print -u2 -- "tag-books: unknown option: $1"
			usage >&2
			exit 64
			;;
		*)
			dirs+=("$1")
			shift
			;;
	esac
done

if (( ${#dirs} == 0 )); then
	usage >&2
	exit 64
fi

for dir in "${dirs[@]}"; do
	if [[ -d "$dir" ]]; then
		dir_name="${dir:t}"
		author=$(echo "$dir_name" | sed 's/^[0-9]* - //;s/ - .*//')
		title=$(echo "$dir_name" | sed 's/^[0-9]* - //;s/^[^-]* - //;s/ - .*//')
		(
			cd "$dir" || exit 1

			mp3_files=( *.mp3(N) )
			if (( ${#mp3_files} == 0 )); then
				print -u2 -- "tag-books: no mp3 files found in $dir"
				exit 0
			fi

			echo "$title"
			i=1
			if [[ "$rename_files" == true ]]; then
				quanti=${#mp3_files}
				digits=1
				if ((quanti > 9)); then
					digits=2
				fi
				if ((quanti >= 99)); then
					digits=3
				fi
				if ((quanti > 999)); then
					digits=4
				fi
				for f in "${mp3_files[@]}"; do
					name=$(printf "%s %0${digits}d.mp3" "$title" "$i")
					((i++))
					mv "$f" "$name"
				done
				mp3_files=( *.mp3(N) )
			fi

			tutti=${#mp3_files}
			i=0
			for file in "${mp3_files[@]}"; do
				data=$(date "+%Y:%m:%d" -d "$base_date+${i}days")
				((i++))
				mid3v2 -T "$i/$tutti" -t "${file:r}" -y "$data" "$file"
			done
			eyeD3 -a "$author" -b "$author" -A "$title" "${mp3_files[@]}"
			if [[ -e "cover.jpg" ]]; then
				eyeD3 --add-image="cover.jpg":FRONT_COVER "${mp3_files[@]}"
			fi
		)
	else
		print -u2 -- "tag-books: not a directory: $dir"
	fi
done
