#!/usr/bin/env zsh

usage() {
	cat <<'EOF'
Usage: tag-books [-r|--rename] [-d|--date DATE] DIRECTORY...

Tag MP3 or M4A audiobook files using metadata inferred from each directory name.

Options:
  -r, --rename     Rename audio files before tagging.
  -d, --date DATE  Base date passed to GNU date. Default: today.
  -h, --help       Show this help.

Directory names are expected to look like:
  Author - Title
  001 - Author - Title
EOF
}

rename_files=false
base_date="today"
typeset -a dirs

while [[ $# -gt 0 ]]; do
	case "$1" in
		-r|--rename)
			rename_files=true
			shift
			;;
		-d|--date)
			if [[ -z "${2:-}" || "${2:0:1}" == "-" ]]; then
				print -u2 -- "tag-books: --date requires a value"
				exit 64
			fi
			base_date="$2"
			shift 2
			;;
		-h|--help)
			usage
			exit 0
			;;
		--)
			shift
			dirs+=("$@")
			break
			;;
		-*)
			print -u2 -- "tag-books: unknown option: $1"
			usage >&2
			exit 64
			;;
		*)
			dirs+=("$1")
			shift
			;;
	esac
done

if (( ${#dirs} == 0 )); then
	usage >&2
	exit 64
fi

for dir in "${dirs[@]}"; do
	if [[ -d "$dir" ]]; then
		dir_name="${dir:t}"
		author=$(echo "$dir_name" | sed 's/^[0-9]* - //;s/ - .*//')
		title=$(echo "$dir_name" | sed 's/^[0-9]* - //;s/^[^-]* - //;s/ - .*//')
		(
			cd "$dir" || exit 1

			typeset -a mp3_files m4a_files audio_files
			mp3_files=( *.mp3(N) )
			m4a_files=( *.m4a(N) )
			if (( ${#mp3_files} > 0 && ${#m4a_files} > 0 )); then
				print -u2 -- "tag-books: mixed MP3 and M4A files are not supported in $dir"
				exit 65
			elif (( ${#mp3_files} > 0 )); then
				format=mp3
				audio_files=( "${mp3_files[@]}" )
			elif (( ${#m4a_files} > 0 )); then
				format=m4a
				audio_files=( "${m4a_files[@]}" )
			else
				print -u2 -- "tag-books: no MP3 or M4A files found in $dir"
				exit 0
			fi

			echo "$title"
			i=1
			if [[ "$rename_files" == true ]]; then
				quanti=${#audio_files}
				digits=1
				if ((quanti > 9)); then
					digits=2
				fi
				if ((quanti >= 99)); then
					digits=3
				fi
				if ((quanti > 999)); then
					digits=4
				fi
				for f in "${audio_files[@]}"; do
					name=$(printf "%s %0${digits}d.%s" "$title" "$i" "$format")
					((i++))
					mv "$f" "$name"
				done
				audio_files=( *.$format(N) )
			fi

			tutti=${#audio_files}
			i=0
			for file in "${audio_files[@]}"; do
				data=$(date "+%Y:%m:%d" -d "$base_date+${i}days")
				((i++))
				if [[ "$format" == mp3 ]]; then
					mid3v2 -T "$i/$tutti" -t "${file:r}" -y "$data" "$file"
				else
					tmp_file="${file:r}.__tag_books_$$.m4a"
					if [[ -e "cover.jpg" ]]; then
						ffmpeg -i "$file" -i "cover.jpg" -map 0:a:0 -map 1:v:0 \
							-map_metadata 0 -c copy -disposition:v:0 attached_pic \
							-metadata track="$i/$tutti" -metadata title="${file:r}" \
							-metadata date="$data" -metadata artist="$author" \
							-metadata album_artist="$author" -metadata album="$title" \
							-movflags +faststart "$tmp_file" -y -loglevel error
					else
						ffmpeg -i "$file" -map 0 -map_metadata 0 -c copy \
							-metadata track="$i/$tutti" -metadata title="${file:r}" \
							-metadata date="$data" -metadata artist="$author" \
							-metadata album_artist="$author" -metadata album="$title" \
							-movflags +faststart "$tmp_file" -y -loglevel error
					fi
					if (( $? != 0 )); then
						rm -f -- "$tmp_file"
						print -u2 -- "tag-books: could not tag $file"
						exit 1
					fi
					mv -- "$tmp_file" "$file"
				fi
			done
			if [[ "$format" == mp3 ]]; then
				eyeD3 -a "$author" -b "$author" -A "$title" "${audio_files[@]}"
				if [[ -e "cover.jpg" ]]; then
					eyeD3 --add-image="cover.jpg":FRONT_COVER "${audio_files[@]}"
				fi
			fi
		)
	else
		print -u2 -- "tag-books: not a directory: $dir"
	fi
done
